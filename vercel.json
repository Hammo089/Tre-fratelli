{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/page?path=/"
    },
    {
      "source": "/en",
      "destination": "/api/page?path=/en"
    },
    {
      "source": "/menu/:path*",
      "destination": "/api/page?path=/menu/:path*"
    },
    {
      "source": "/en/menu/:path*",
      "destination": "/api/page?path=/en/menu/:path*"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    }
  }
}